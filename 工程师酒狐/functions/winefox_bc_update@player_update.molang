    t.from = v.winefox_bc_combo ? 0.2083 : 0;
    v.winefox_bc_blend = v.winefox_bc_combo ? math.clamp(t.elapsed / math.min(0.12, 0.2 / v.winefox_bc_speed), 0, 1) : 1;
    v.winefox_bc_blend = v.winefox_bc_blend * v.winefox_bc_blend * (3 - 2 * v.winefox_bc_blend);
    (t.hit_age < 0) ? {
