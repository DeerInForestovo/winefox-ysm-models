        };
    };
};
// Only an empty input can finish the single-hit recovery. Unknown attacks cancel.
t.display_match = (v.winefox_bc_action <= 3 && t.sword) || (v.winefox_bc_action >= 4 && v.winefox_bc_action <= 5 && t.model_axe) || (v.winefox_bc_action >= 6 && t.axe && t.model_axe == 0);
t.keep = t.display_match && ysm.swinging_arm == 0 && t.empty && v.winefox_bc_phase < 1;
v.winefox_bc_input = t.action;
(t.action == 0 && t.keep) ? { t.action = v.winefox_bc_action; };
v.winefox_bc_action = t.action;
(v.winefox_bc_action == 0) ? { v.winefox_bc_phase = 0; v.winefox_bc_axe_stage = 0; };
v.winefox_bc_last_swing = ysm.swing_time;
